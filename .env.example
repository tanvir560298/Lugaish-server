MONGODB_URI=mongodb://localhost:27017/lugaish
JWT_SECRET=your_jwt_secret_key_change_in_production
# Production requires a unique JWT_SECRET with at least 32 characters.
FIREBASE_PROJECT_ID=your-firebase-project-id
WEB_DEVELOPER_EMAILS=tahmadium@gmail.com
COURSE_SEAT_LIMIT_ENGLISH=110
COURSE_SEAT_LIMIT_ARABIC=55
INTERVIEW_ROOM_CAPACITIES=25,25,25,25
INTERVIEW_ROOM_1_URL=https://meet.google.com/your-room-one
INTERVIEW_ROOM_2_URL=https://meet.google.com/your-room-two
INTERVIEW_ROOM_3_URL=https://meet.google.com/your-room-three
INTERVIEW_ROOM_4_URL=https://meet.google.com/your-room-four
INTERVIEW_SUPPORT_EMAIL=lugaish2026@gmail.com
FRONTEND_URL=http://localhost:4174
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:5001/api/email/oauth/callback
GMAIL_SENDER_EMAIL=tahmadium@gmail.com
EMAIL_MANAGER_EMAILS=tahmadium@gmail.com
GMAIL_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
PORT=5000
# Development binds loopback by default. Change only for an intentionally trusted LAN.
API_BIND_HOST=127.0.0.1
CORS_ORIGIN=https://lugaish.vercel.app,http://localhost:4174

# Production: replace CORS_ORIGIN above with the exact approved HTTPS origin.
# Leave unset for direct requests. Set only the actual trusted proxy subnet/name.
# TRUST_PROXY=loopback

# Tanu online tutor: disabled until a provider and approved spending limits exist.
# Server secrets only. Never use VITE_ for any AI key.
NOVYRA_PAID_ENABLED=false
NOVYRA_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Or choose openai above and set OPENAI_API_KEY instead.
OPENAI_API_KEY=
# Pin a model available to your provider account; do not leave this empty when enabling.
NOVYRA_MODEL_NAME=
# Set approved limits and conservative current token prices for the selected model.
# Blank budgets/rates deliberately keep online AI disabled.
NOVYRA_DAILY_BUDGET_USD=
NOVYRA_MONTHLY_BUDGET_USD=
NOVYRA_INPUT_USD_PER_MILLION=
NOVYRA_OUTPUT_USD_PER_MILLION=
NOVYRA_MAX_CONCURRENT_REQUESTS=4
NOVYRA_DAILY_REQUEST_LIMIT=200
NOVYRA_DAILY_TOKEN_LIMIT=150000
